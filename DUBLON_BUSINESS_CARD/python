using System;

namespace HelloWorld;

class program
{
    static void Main(string[] args)
    {
        for(int i = 1; i<=4; i++) {
            for (int j = 4; j>=i; j--) {
                Console.Write(" ");
                if (j==i) {
                    Console.WriteLine("*");
                }
            }
        }
        Console.WriteLine("*");
    }   
}